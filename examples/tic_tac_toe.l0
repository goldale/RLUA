-- A deterministic replay of a Tic-Tac-Toe game.
-- Board cells are zero-indexed: 0 = empty, 1 = X, 2 = O.
let board: tensor<i8, 2> = zeros<i8>([3, 3])
let x: i8 = 1
let o: i8 = 2

board[0, 0] = x
board[0, 1] = o
board[1, 1] = x
board[0, 2] = o
board[2, 2] = x

-- Print the resulting board, then the winner.
print(board[0, 0])
print(board[0, 1])
print(board[0, 2])
print(board[1, 0])
print(board[1, 1])
print(board[1, 2])
print(board[2, 0])
print(board[2, 1])
print(board[2, 2])

if board[0, 0] == board[1, 1] then
    if board[1, 1] == board[2, 2] then
        print(x)
    end
end
