-- Интерактивные Крестики-Нолики (OXO) на L0 с использованием 2D-тензора
let board: tensor<i8, 2> = zeros<i8>([3, 3])
let active: bool = 1 == 1
let turn: i8 = 1

printf("--- Крестики-нолики ---\n")
printf("Вы играете за крестики (X).\n")
printf("Для хода введите номер свободной ячейки от 0 до 8.\n\n")

while active do
    -- 1. Отрисовка доски
    let d: i32 = 0
    while d < 9 do
        let r: i32 = d / 3
        let c: i32 = d % 3
        let cell: i8 = board[r, c]
        if cell == 0 then printf("[{}] ", d) end
        if cell == 1 then printf(" X  ") end
        if cell == 2 then printf(" O  ") end
        if c == 2 then printf("\n") end
        d = d + 1
    end
    printf("\n")

    -- 2. Проверка статуса игры
    let winner: i8 = 0
    if board[0, 0] != 0 && board[0, 0] == board[0, 1] && board[0, 1] == board[0, 2] then winner = board[0, 0] end
    if board[1, 0] != 0 && board[1, 0] == board[1, 1] && board[1, 1] == board[1, 2] then winner = board[1, 0] end
    if board[2, 0] != 0 && board[2, 0] == board[2, 1] && board[2, 1] == board[2, 2] then winner = board[2, 0] end
    if board[0, 0] != 0 && board[0, 0] == board[1, 0] && board[1, 0] == board[2, 0] then winner = board[0, 0] end
    if board[0, 1] != 0 && board[0, 1] == board[1, 1] && board[1, 1] == board[2, 1] then winner = board[0, 1] end
    if board[0, 2] != 0 && board[0, 2] == board[1, 2] && board[1, 2] == board[2, 2] then winner = board[0, 2] end
    if board[0, 0] != 0 && board[0, 0] == board[1, 1] && board[1, 1] == board[2, 2] then winner = board[0, 0] end
    if board[0, 2] != 0 && board[0, 2] == board[1, 1] && board[1, 1] == board[2, 0] then winner = board[0, 2] end

    let has_empty: bool = 1 == 0
    let e: i32 = 0
    while e < 9 do
        if board[e / 3, e % 3] == 0 then has_empty = 1 == 1 end
        e = e + 1
    end

    if winner != 0 then
        if winner == 1 then printf("★★★ ВЫ ПОБЕДИЛИ! ★★★\n") end
        if winner == 2 then printf("☠ КОМПЬЮТЕР ПОБЕДИЛ! ☠\n") end
        active = 1 == 0
    else
        if has_empty == (1 == 0) then
            printf("Ничья! Победила дружба.\n")
            active = 1 == 0
        end
    end

    -- 3. Выполнение хода
    if active then
        if turn == 1 then
            printf("Ваш ход (0-8): ")
            let move: i32 = input
            
            if move >= 0 && move <= 8 then
                if board[move / 3, move % 3] == 0 then
                    board[move / 3, move % 3] = 1
                    turn = 2
                else
                    printf("Ошибка: эта ячейка уже занята!\n\n")
                end
            else
                printf("Ошибка: неверный номер ячейки!\n\n")
            end
        else
            printf("Ход компьютера...\n\n")
            let best_move: i32 = -1
            let i: i32 = 0

            -- А: Может ли ИИ победить прямо сейчас?
            while i < 9 do
                let r: i32 = i / 3
                let c: i32 = i % 3
                if best_move == -1 && board[r, c] == 0 then
                    board[r, c] = 2
                    let cand: i8 = 0
                    if board[0, 0] != 0 && board[0, 0] == board[0, 1] && board[0, 1] == board[0, 2] then cand = board[0, 0] end
                    if board[1, 0] != 0 && board[1, 0] == board[1, 1] && board[1, 1] == board[1, 2] then cand = board[1, 0] end
                    if board[2, 0] != 0 && board[2, 0] == board[2, 1] && board[2, 1] == board[2, 2] then cand = board[2, 0] end
                    if board[0, 0] != 0 && board[0, 0] == board[1, 0] && board[1, 0] == board[2, 0] then cand = board[0, 0] end
                    if board[0, 1] != 0 && board[0, 1] == board[1, 1] && board[1, 1] == board[2, 1] then cand = board[0, 1] end
                    if board[0, 2] != 0 && board[0, 2] == board[1, 2] && board[1, 2] == board[2, 2] then cand = board[0, 2] end
                    if board[0, 0] != 0 && board[0, 0] == board[1, 1] && board[1, 1] == board[2, 2] then cand = board[0, 0] end
                    if board[0, 2] != 0 && board[0, 2] == board[1, 1] && board[1, 1] == board[2, 0] then cand = board[0, 2] end
                    if cand == 2 then best_move = i end
                    board[r, c] = 0
                end
                i = i + 1
            end

            -- Б: Блокировка игрока
            if best_move == -1 then
                i = 0
                while i < 9 do
                    let r: i32 = i / 3
                    let c: i32 = i % 3
                    if best_move == -1 && board[r, c] == 0 then
                        board[r, c] = 1
                        let cand: i8 = 0
                        if board[0, 0] != 0 && board[0, 0] == board[0, 1] && board[0, 1] == board[0, 2] then cand = board[0, 0] end
                        if board[1, 0] != 0 && board[1, 0] == board[1, 1] && board[1, 1] == board[1, 2] then cand = board[1, 0] end
                        if board[2, 0] != 0 && board[2, 0] == board[2, 1] && board[2, 1] == board[2, 2] then cand = board[2, 0] end
                        if board[0, 0] != 0 && board[0, 0] == board[1, 0] && board[1, 0] == board[2, 0] then cand = board[0, 0] end
                        if board[0, 1] != 0 && board[0, 1] == board[1, 1] && board[1, 1] == board[2, 1] then cand = board[0, 1] end
                        if board[0, 2] != 0 && board[0, 2] == board[1, 2] && board[1, 2] == board[2, 2] then cand = board[0, 2] end
                        if board[0, 0] != 0 && board[0, 0] == board[1, 1] && board[1, 1] == board[2, 2] then cand = board[0, 0] end
                        if board[0, 2] != 0 && board[0, 2] == board[1, 1] && board[1, 1] == board[2, 0] then cand = board[0, 2] end
                        if cand == 1 then best_move = i end
                        board[r, c] = 0
                    end
                    i = i + 1
                end
            end

            -- В: Занять центр
            if best_move == -1 && board[1, 1] == 0 then best_move = 4 end

            -- Г: Любая ячейка
            if best_move == -1 then
                i = 0
                while i < 9 do
                    if best_move == -1 && board[i / 3, i % 3] == 0 then best_move = i end
                    i = i + 1
                end
            end

            if best_move != -1 then
                board[best_move / 3, best_move % 3] = 2
                turn = 1
            end
        end
    end
end
