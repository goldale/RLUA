-- examples/gc_test.l0

printf("Начало стресс-теста сборщика мусора...\n")
let i: i64 = 0
let dummy_string: string = "init"
-- Запуск цикла на 999 999 итераций
while i < 999999 do
    -- Операция сложения строк аллоцирует новый объект HeapObject::String 
    -- в куче на каждой итерации. Старые объекты будут автоматически 
    -- собираться сборщиком мусора при превышении threshold_bytes.
    dummy_string = "mem-Chunk-partA-" + "partB" + int2str(i)
    i = i + 1
end

printf("Успешно выполнено {} итераций. GC работает штатно.\n", i)
