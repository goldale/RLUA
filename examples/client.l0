-- client.l0
-- Эмуляция клиентской логики Admin Script на языке L0

-- ОБНОВЛЕНИЕ: Таблица должна быть объявлена ВНЕ структуры (до неё),
-- так как структуры поддерживают только скалярные типы данных.
let admins: table<bool> = table { [0] = 1 == 0 }

struct Client {
    local_player_id: i32;
    local_pos_x: f32;
    local_pos_y: f32;
    local_pos_z: f32;

    -- Поля-аргументы для методов
    target_id: i32;
    target_x: f32;
    target_y: f32;
    target_z: f32;

    -- Эмуляция: adminpursuit:AddAdmin
    function add_admin()
        admins[target_id] = 1 == 1 -- true
        printf("[Client] Игрок {} получил права админа.\n", target_id)
    end

    -- Эмуляция: adminpursuit:RemoveAdmin
    function remove_admin()
        admins[target_id] = 1 == 0 -- false
        printf("[Client] Игрок {} лишен прав админа.\n", target_id)
    end

    -- Эмуляция цикла Citizen.CreateThread и проверок дистанции
    function check_pursuit_proximity()
        let is_admin: bool = admins[target_id]

        if is_admin then
            let dx: f32 = local_pos_x - target_x
            let dy: f32 = local_pos_y - target_y
            let dz: f32 = local_pos_z - target_z

            let dist_sq: f32 = (dx * dx) + (dy * dy) + (dz * dz)

            if dist_sq < 5625.0 then
                printf("~g~Priorities Are On Hold\n")
                printf("~r~ ADMIN PURSUIT NEARBY\n")
                printf("~y~ Pull over, and stop what you are doing!\n")
                printf("~o~ There is currently an Admin in pursuit!\n")
            end
        end
    end
}

-- Инициализация клиентского окружения
let client_env: Client = Client {
    local_player_id = 12,
    local_pos_x = 100.0,
    local_pos_y = 200.0,
    local_pos_z = 30.0,
    target_id = 0,
    target_x = 0.0,
    target_y = 0.0,
    target_z = 0.0
}

-- Симуляция работы скрипта:
client_env.target_id = 5
client_env.add_admin()  -- Пришел эвент: игрок 5 стал админом

client_env.target_id = 12
client_env.add_admin() -- Локальный игрок стал админом

-- Игровой цикл: проверяем дистанцию до админа (ID 5)
client_env.target_id = 5
client_env.target_x = 120.0
client_env.target_y = 210.0
client_env.target_z = 30.0
client_env.check_pursuit_proximity()

-- Убираем админа и проверяем снова (ошибок/вывода не будет)
client_env.target_id = 5
client_env.remove_admin()
client_env.check_pursuit_proximity()
