printf("========== INTENSIVE ForIn LOOP TEST ==========\n")

-- 1. Iterating over a Vector (Array)
printf("\n--- Test 1: vector<i32> Iteration ---\n")
let vec: vector<i32> = [10, 20, 30, 40, 50]
let sum_vec: i32 = 0

for v in vec do
    sum_vec = sum_vec + v
    printf("Vector item: {}", v)
end
printf("\nTotal Vector Sum: {} (Expected: 150)\n", sum_vec)

-- 2. Iterating over a 1D Tensor
printf("\n--- Test 2: tensor<f32, 1> Iteration ---\n")
let tns: tensor<f32, 1> = zeros<f32>([4])
tns[0] = 1.1
tns[1] = 2.2
tns[2] = 3.3
tns[3] = 4.4

let sum_tns: f32 = 0.0
for val in tns do
    sum_tns = sum_tns + val
    printf("Tensor item: {}", val)
end
printf("\nTotal Tensor Sum: {} (Expected: 11.0)\n", sum_tns)

-- 3. Iterating over Table Keys
-- The 'keys()' built-in returns a table_keys object which is iterable.
printf("\n--- Test 3: table_keys Iteration ---\n")
let map: table<string> = table {
    [100] = "Alpha",
    [200] = "Beta",
    name = "Gamma"
}
let tkeys: table_keys = keys(map)

for k in tkeys do
    -- 'k' is strictly of type 'table_key'
    printf("Table Key: {}, Value: {}", k, map[k])
end

-- 4. Testing 'break' and 'continue' control flow
-- This tests if the VM properly cleans up the 4 internal slots when jumping out of the loop.
printf("\n--- Test 4: break and continue ---\n")
let flow_vec: vector<i32> = [1, 2, 3, 4, 5, 6, 7]

printf("Expected output: 1, 3, 4, 5")
for x in flow_vec do
    if x == 2 then
        continue -- Skip 2
    end

    if x == 6 then
        break -- Stop completely before printing 6
    end

    printf("Flow item: {}", x)
end

-- 5. Nested ForIn loops
-- This ensures the compiler's `self.next_slot` correctly tracks and rewinds temporary slot allocations across nested scopes.
printf("\n--- Test 5: Nested ForIn Loops ---\n")
let outer_vec: vector<i32> = [1, 2]
let inner_map: table<string> = table {
    [0] = "Aaaaaaa",
    [1] = "Byyyyyyy"
}
let tkeys: table_keys = keys(inner_map)

for o in outer_vec do
    for k in tkeys do
        printf("Outer: {}, Inner: {}", o, inner_map[k])
    end
end

printf("\n========== TESTS COMPLETED ==========\n")
