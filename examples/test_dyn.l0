printf("=== RUN DArray и DTensor: Базовое приведение ===\n")

-- 1. Работа с DynArray
let orig_vec: vector<i32> = [10, 20, 30]

-- Upcast: приведение к динамическому массиву
let dyn_vec: dArray = orig_vec

-- Downcast: приведение обратно к строгому типу
let restored_vec: vector<i32> = dyn_vec

-- Мутация через восстановленную ссылку
restored_vec[1] = 99

printf("Ожидается 99, получено: {}\n", orig_vec[1])

-- 2. Работа с DynTensor
let orig_tensor: tensor<f32, 2> = zeros<f32>([2, 2])
orig_tensor[0, 1] = 3.14

-- Upcast
let dyn_tensor: dTensor = orig_tensor

-- Downcast
let restored_tensor: tensor<f32, 2> = dyn_tensor
restored_tensor[1, 0] = 2.71

printf("Tensor [0, 1] (через оригинал): {}\n", orig_tensor[0, 1])
printf("Tensor [1, 0] (через восстановленный): {}\n", orig_tensor[1, 0])

printf("=== RUN DynArray и DynTensor: Использование в структурах ===\n")

struct AnyContainer {
    -- Поля объявлены с динамическими типами
    v_data: dArray;
    t_data: dTensor;

    function process_as_i32()
        -- Метод предполагает, что внутри лежат данные типа i32
        let local_v: vector<i32> = this.v_data
        let local_t: tensor<i32, 1> = this.t_data
        local_v[0] = local_v[0] * 2
        local_t[0] = local_t[0] + 10
    end
}

let int_vec: vector<i32> = [5, 15, 25]
let int_tensor: tensor<i32, 1> = zeros<i32>([1])
int_tensor[0] = 100

let container: AnyContainer = AnyContainer {
    v_data = int_vec,
    t_data = int_tensor
}
container.process_as_i32()

printf("Умноженный vector[0] (ожидается 10): {}\n", int_vec[0])
printf("Измененный tensor[0] (ожидается 110): {}\n", int_tensor[0])

printf("=== RUN DynArray: Проверка рантайм-защиты (исправлено) ===\n")

let v_i32: vector<i32> = [42]

-- Upcast к динамическому массиву проходит успешно
let v_dyn: dArray = v_i32

-- Исправленный Downcast: тип должен совпадать с исходным
let v_restored: vector<i32> = v_dyn

-- Безопасное математическое действие с предварительным явным приведением типа
let good_math: f32 = (v_restored[0] as f32) + 1.5

print(good_math)
