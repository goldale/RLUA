let a: f32 = 144.0
let b: f32 = sqrt(a)           -- 12.0
let rad: f32 = sin(0.5)        -- Синус 0.5 радиан
let p: i32 = pow(2, 8)         -- 2 в 8 степени = 256
let m: f64 = max(10.5, 20.0)   -- 20.0
let f: f32 = floor(5.8)        -- 5.0

-- Для вычисления дистанции (Vdist) из GTA V
let dx: f32 = 100.0 - 50.0
let dy: f32 = 200.0 - 150.0
let vdist: f32 = sqrt(pow(dx, 2.0) + pow(dy, 2.0))
