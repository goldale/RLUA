-- Интерактивная игра Судоку на языке L0 с поддержкой ввода (input).
-- 0 означает пустую ячейку; доска представляет собой плоский массив 9 x 9 (81 ячейка), проиндексированный с нуля.
-- Игрок указывает строку (0-8), колонку (0-8) и значение (1-9).

let board: vector<i8> = [
    0, 0, 0, 0, 0, 0, 0, 7, 5,
    1, 6, 0, 5, 0, 0, 0, 8, 0,
    0, 0, 3, 0, 0, 9, 0, 0, 1,
    5, 3, 0, 7, 0, 4, 2, 9, 0,
    0, 4, 8, 0, 9, 0, 6, 5, 0,
    0, 9, 6, 3, 0, 5, 0, 4, 7,
    6, 0, 0, 4, 0, 0, 5, 0, 0,
    0, 1, 0, 0, 0, 8, 0, 2, 6,
    9, 7, 0, 0, 0, 0, 0, 0, 0
]

let active: bool = 1 == 1

while active do
    -- Вывод текущего состояния доски
    sudoku_show(board)
    
    -- Получение хода от игрока (интерактивный ввод строки, столбца и числа)
    board = sudoku_human_move(board)

    -- Проверка, решена ли головоломка
    let solved: bool = sudoku_is_solved(board)
    if solved then
        active = 1 == 0
    end
end

-- Финальный вывод и поздравление
sudoku_show(board)
print("Поздравляем! Судоку успешно решено!")
