-- entropy_profiler.l0
struct EntropyProfiler {
    entropy: f32;
    -- Добавляем "аргументы" как поля структуры
    hidden_states: dTensor;
    eps: f32;

    -- Метод строго без аргументов
    function calculate()
        let h_flat: dTensor = t_reshape(hidden_states, -1, 4096)
        let h_mean: dTensor = mean_dim0(h_flat)
        let h_centered: dTensor = t_sub(h_flat, h_mean)
        let singular_values: dTensor = svdvals(h_centered)
        let variance: dTensor = t_square(singular_values)

        let var_sum: f32 = t_sum(variance)
        let norm_factor: f32 = var_sum + eps
        let probabilities: dTensor = t_scalarDiv(variance, norm_factor)

        let prob_eps: dTensor = t_scalarAdd(probabilities, eps)
        let log_prob: dTensor = t_log(prob_eps)
        let term: dTensor = t_mul(probabilities, log_prob)
        let term_sum: f32 = t_sum(term)

        entropy = 0.0 - term_sum
    end
}

let test_layer: tensor<f32, 2> = zeros<f32>([512, 4096])

-- Инициализируем профайлер, передавая данные через поля
let profiler: EntropyProfiler = EntropyProfiler {
    entropy = 0.0,
    hidden_states = test_layer,
    eps = 0.000000001
}

-- Вызов метода без аргументов
profiler.calculate()

printf("Спектральная энтропия слоя: {}\n", profiler.entropy)
