printf("=== ДЕМО: ХУК ПРОМЕЖУТОЧНОГО СЛОЯ ===\n")

-- Единственная переменная конфигурации
let target_layer: i32 = 17

let layer_str: string = int2str(target_layer as i64)
if target_layer < 10 then
    layer_str = "0" + layer_str
end

let hook_key: string = "layer_" + layer_str + "_hidden_state"
let save_path: string = "hook_layer" + layer_str + "_output.safetensors"

let model_path: string = "smollm2-1.7b-fp32.safetensors"
printf("Загрузка весов из: {} ...\n", model_path)
-- ... [дальше идет обычный цикл инференса while l <= target_layer] ...

-- В конце файла сохранение теперь выглядит так:
let hook_data: table<i32> = table { }
hook_data[hook_key] = x

let success: bool = candle_save_model(hook_data, save_path)

if success then
    printf("Тензор успешно сохранен под ключом [{}] в файл: {}\n", hook_key, save_path)
else
    printf("Ошибка при сохранении тензора!\n")
end

candle_free_tensor(x)
