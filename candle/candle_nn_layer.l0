-- Подключаем модуль candle (если вы реализовали его загрузку через require)
--let candle: module = require("candle") -- Опционально, если они не в глобальной области
printf("=== CANDLE: ПОЛНОЦЕННЫЙ СЛОЙ НЕЙРОСЕТИ ===\n")

-- 1. Веса (W): 3 выходных нейрона, 4 входных фичи
let weights: tensor<f32, 2> = zeros<f32>([3, 4])
weights[0, 0] = 1.0; weights[0, 1] = -1.0; weights[0, 2] =  0.5; weights[0, 3] =  1.0;
weights[1, 0] = 0.0; weights[1, 1] =  2.0; weights[1, 2] = -0.5; weights[1, 3] = -1.0;
weights[2, 0] = 1.0; weights[2, 1] =  1.0; weights[2, 2] =  1.0; weights[2, 3] =  1.0;

-- 2. Вход (x)
let input_dt: vector<f32> = [1.0, 2.0, -1.0, 0.5]

-- 3. Смещение / Bias (b)
let bias: vector<f32> = [0.1, -0.5, 0.0]

-- Шаг A: Умножение (W * x)
-- L0 автоматически поймет, что weights (tensor) это dTensor, а input_dt (vector) это dArray
let wx: dArray = candle_l0_layer(weights, input_dt)
-- Шаг B: Добавление Bias (W * x + b)
let wx_b: dArray = candle_vector_add(wx, bias)
-- Шаг C: Активация ReLU ( max(0, W * x + b) )
let output_dyn: dArray = candle_vector_relu(wx_b)

-- Приводим к строгому типу для чтения
let out_vector: vector<f32> = output_dyn

printf("\nРезультат прохода через слой (W*x + b -> ReLU):\n")
printf("Нейрон 0: {}\n", out_vector[0])
printf("Нейрон 1: {}\n", out_vector[1])
printf("Нейрон 2: {}\n", out_vector[2])
