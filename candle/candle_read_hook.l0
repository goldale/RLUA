printf("=== ДЕМО: ЧТЕНИЕ ХУКА ИЗ СЛОЯ ===\n")

-- Единственная переменная конфигурации!
let target_layer: i32 = 17

-- Автоматическое форматирование с ведущим нулем (например, 9 превратится в "09", а 17 в "17")
let layer_str: string = int2str(target_layer as i64)
if target_layer < 10 then
    layer_str = "0" + layer_str
end
-- Динамическая генерация пути к файлу и ключа для поиска тензора
let hook_path: string = "hook_layer" + layer_str + "_output.safetensors"
let hook_key: string = "layer_" + layer_str + "_hidden_state"

printf("Ожидается слой: {}\n", target_layer)
printf("Загружаем данные из: {} ...\n", hook_path)

-- Читаем файл. Возвращается таблица, где ключи - имена тензоров (строки), а значения - их ID[cite: 2]
let loaded_data: table<i32> = candle_load_model(hook_path)
-- Динамическое обращение к таблице по сгенерированному ключу
let x_id: i32 = loaded_data[hook_key]
printf("Тензор [{}] успешно загружен! Внутренний ID: {}\n", hook_key, x_id)
-- Выгружаем данные тензора обратно в пространство L0 в виде динамического массива[cite: 2]
let hook_dyn: dArray = candle_get_darray(x_id)
-- Приводим к строгому вектору (FP32), чтобы можно было читать и менять элементы
let hook_vec: vector<f32> = hook_dyn
-- Проверяем размер вектора
let vec_len: i32 = len(hook_vec)
printf("Размер извлеченного вектора: {} (Ожидается 2048)\n", vec_len)
-- Выводим первые несколько значений для верификации
printf("\nПервые 5 значений скрытого состояния:\n")
printf("[0]: {}\n", hook_vec[0])
printf("[1]: {}\n", hook_vec[1])
printf("[2]: {}\n", hook_vec[2])
printf("[3]: {}\n", hook_vec[3])
printf("[4]: {}\n", hook_vec[4])

-- ЗДЕСЬ БУДЕТ ВАША ЛОГИКА:
-- 1. Вызов скрипта инференса SAE для этого вектора.
-- 2. Модификация значений вектора (Concept Injection).
-- 3. Конвертация измененного вектора обратно в тензор и передача в следующие слои.

-- Очищаем VRAM за собой прямым вызовом функции[cite: 2]
candle_free_tensor(x_id)
printf("\n=== ЧТЕНИЕ ЗАВЕРШЕНО ===\n")
