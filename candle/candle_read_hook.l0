printf("=== ДЕМО: ЧТЕНИЕ ХУКА ПРОМЕЖУТОЧНОГО СЛОЯ ===\n")

let hook_path: string = "hook_layer9_output.safetensors"
printf("Загружаем данные из: {} ...\n", hook_path)

-- 1. Читаем safetensors с диска.
-- Функция возвращает таблицу, где ключ - имя тензора, а значение - его ID в Candle
let loaded_data: table<i32> = candle_load_model(hook_path)

-- 2. Получаем ID нужного нам состояния
let x_id: i32 = loaded_data["layer_09_hidden_state"]
printf("Тензор успешно загружен в память! Внутренний ID: {}\n", x_id)

-- 3. Выгружаем данные тензора обратно в пространство L0 (в виде динамического массива)
let hook_dyn: dArray = candle_get_darray(x_id)

-- Приводим к строгому вектору (FP32), чтобы можно было читать и менять элементы
let hook_vec: vector<f32> = hook_dyn

-- Проверяем размер: у 1.7B модели Hidden Size = 2048
let vec_len: i32 = len(hook_vec)
printf("Размер извлеченного вектора: {} (Ожидается 2048)\n", vec_len)

-- 4. Выводим первые несколько значений для верификации
printf("\nПервые 5 значений скрытого состояния:\n")
printf("[0]: {}\n", hook_vec[0])
printf("[1]: {}\n", hook_vec[1])
printf("[2]: {}\n", hook_vec[2])
printf("[3]: {}\n", hook_vec[3])
printf("[4]: {}\n", hook_vec[4])

-- ЗДЕСЬ МОЖНО ВСТРАИВАТЬ ЛОГИКУ:
-- Например, модифицировать значения вектора (hook_vec[0] = 99.9),
-- затем конвертировать вектор обратно в тензор и передать его в слои с 10 по 23!

-- 5. Очищаем VRAM за собой
candle_free_tensor(x_id)
printf("\n=== ЧТЕНИЕ ЗАВЕРШЕНО ===\n")
