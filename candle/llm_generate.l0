printf("=== СТАРТ ГЕНЕРАЦИИ ТЕКСТА (SmolLM-135M) ===\n")
let weights: table<i32> = candle_load_model("smollm-135m.safetensors")

let w_emb: i32 = weights["model.embed_tokens.weight"]
let w_ln_f: i32 = weights["model.norm.weight"]
let w_lm_head: i32 = weights["lm_head.weight"]

-- В L0 нет встроенного токенизатора строк, поэтому мы подаём ID токена напрямую.
-- 2048 в моделях LLaMA обычно означает что-то вроде пробела или буквы "T"
let current_token: i32 = 2048
let pos: i32 = 0

-- Массивы для хранения ID тензоров KV-кэша для каждого из 30 слоев
let k_caches: tensor<i32, 1> = zeros<i32>([30])
let v_caches: tensor<i32, 1> = zeros<i32>([30])

printf("Запускаем цикл генерации 10 токенов...\n\n")

while pos < 10 do
    printf("Позиция {}: Входной Токен ID = {}", pos, current_token)

    -- 1. Получаем вектор эмбеддинга
    let x: i32 = candle_embedding(w_emb, current_token)

    -- 2. Проход через все 30 слоев трансформера
    let l: i32 = 0
    while l < 30 do
        -- L0 динамически собирает имя нужного веса из строки и номера слоя!
        let prefix: string = "model.layers." + int2str(l as i64)

        -- ================= АТТЕНШН (Внимание) =================
        let w_norm1: i32 = weights[prefix + ".input_layernorm.weight"]
        let x_norm: i32 = candle_rmsnorm(x, w_norm1, 0.00001)

        let q: i32 = candle_linear_id(weights[prefix + ".self_attn.q_proj.weight"], x_norm)
        let k: i32 = candle_linear_id(weights[prefix + ".self_attn.k_proj.weight"], x_norm)
        let v: i32 = candle_linear_id(weights[prefix + ".self_attn.v_proj.weight"], x_norm)

        -- Превращаем плоские векторы в 4D-головы: [Batch=1, Heads, SeqLen=1, HeadDim=64]
        let q_heads: i32 = candle_reshape_id(q, [1.0, 9.0, 1.0, 64.0])
        let k_heads: i32 = candle_reshape_id(k, [1.0, 3.0, 1.0, 64.0])
        let v_heads: i32 = candle_reshape_id(v, [1.0, 3.0, 1.0, 64.0])

        -- Добавляем информацию о позиции слова в предложении (RoPE)
        let q_rope: i32 = candle_apply_rope_id(q_heads, pos, 64)
        let k_rope: i32 = candle_apply_rope_id(k_heads, pos, 64)

        -- Обновление KV Cache (Магия "памяти" нейросети)
        let k_final: i32 = 0
        let v_final: i32 = 0
        if pos == 0 then
            k_final = k_rope
            v_final = v_heads
        else
            -- Доклеиваем новый токен к истории предыдущих токенов по оси SeqLen (dim = 2)
            k_final = candle_cat_id(k_caches[l], k_rope, 2)
            v_final = candle_cat_id(v_caches[l], v_heads, 2)
        end
        -- Сохраняем обратно в память
        k_caches[l] = k_final
        v_caches[l] = v_final

        -- Размножаем K и V (Механика Grouped Query Attention)
        let k_rep: i32 = candle_repeat_kv_id(k_final, 3)
        let v_rep: i32 = candle_repeat_kv_id(v_final, 3)

        -- Умножаем (Q * K^T) / sqrt(64) и применяем Softmax
        let k_t: i32 = candle_transpose_id(k_rep, 2, 3)
        let scores: i32 = candle_matmul_id(q_rope, k_t)
        let scaled_scores: i32 = candle_scale_id(scores, 0.125)
        let attn_probs: i32 = candle_softmax_dim_id(scaled_scores, 3)

        -- Умножаем вероятности на V
        let context: i32 = candle_matmul_id(attn_probs, v_rep)

        -- Сворачиваем обратно в плоский вектор [576]
        let context_flat: i32 = candle_reshape_id(context, [576.0])
        let attn_out: i32 = candle_linear_id(weights[prefix + ".self_attn.o_proj.weight"], context_flat)

        -- Residual связь
        x = candle_add_id(x, attn_out)

        -- ================= MLP (Feed-Forward) =================
        let w_norm2: i32 = weights[prefix + ".post_attention_layernorm.weight"]
        let x_norm2: i32 = candle_rmsnorm(x, w_norm2, 0.00001)

        let gate: i32 = candle_linear_id(weights[prefix + ".mlp.gate_proj.weight"], x_norm2)
        let up: i32 = candle_linear_id(weights[prefix + ".mlp.up_proj.weight"], x_norm2)
        let act: i32 = candle_silu(gate)
        let mul: i32 = candle_mul_id(act, up)
        let down: i32 = candle_linear_id(weights[prefix + ".mlp.down_proj.weight"], mul)

        -- Вторая Residual связь
        x = candle_add_id(x, down)

        l = l + 1
    end
    -- 3. Финальная нормализация и получение логитов словаря (Language Model Head)
    let final_norm: i32 = candle_rmsnorm(x, w_ln_f, 0.00001)
    let logits: i32 = candle_linear_id(w_lm_head, final_norm)

    -- 4. Выбираем слово с наибольшей вероятностью
    current_token = candle_argmax_token(logits)
    printf(" ---> Сгенерирован следующий токен: {}\n", current_token)

    pos = pos + 1
end

printf("\n=== ГЕНЕРАЦИЯ ЗАВЕРШЕНА ===\n")
